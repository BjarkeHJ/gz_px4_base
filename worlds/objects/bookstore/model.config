<?xml version="1.0"?>
<model>
  <name>bookstore</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>Extracted from AWS RoboMaker bookstore.world</name>
  </author>
  <description>
    Composite model bundling all retail-shop / bookstore objects from the
    aws_robomaker_bookstore_world. Include with:
      <include><uri>model://bookstore</uri></include>
    Pair with bookstore_lights.sdf if you want the original ceiling lights
    (lights cannot be nested inside a model in SDF).
  </description>
</model>
